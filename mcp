#!/bin/sh
# The Host runs this file and speaks MCP to it over stdio. It is a wrapper and
# nothing else: the entry point is TypeScript, which Node runs with no build
# step, and a Plugin is a convention rather than a manifest (FirstMate
# ADR-0002).
#
# It looks for a Node rather than trusting `node`, because a service's PATH is
# not a login shell's. The Host runs under systemd with
# PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin, which has no nvm on
# it, so `#!/usr/bin/env node` finds whichever Node the distribution ships —
# and an old one fails with "Unknown file extension .ts", which says nothing
# about versions to whoever has to read it. Node 24 is also what brings
# node:sqlite, where research keeps its Topics.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# A Plugin Release ships mcp.js, one bundle, and no source; a clone runs
# src/main.ts as it is. The same wrapper serves both.
if [ -f "$here/mcp.js" ]; then entry="$here/mcp.js"; else entry="$here/src/main.ts"; fi

for node in ${RESEARCH_NODE:+"$RESEARCH_NODE"} \
            "$(command -v node 2>/dev/null)" \
            "$HOME"/.nvm/versions/node/*/bin/node; do
  [ -x "$node" ] || continue
  major=$("$node" -p 'process.versions.node.split(".")[0]' 2>/dev/null) || continue
  [ "$major" -ge 24 ] 2>/dev/null || continue
  exec "$node" "$entry"
done

echo "research: no Node 24 or newer was found, and this Plugin is TypeScript that Node runs with no build step. Set RESEARCH_NODE to a Node 24, or start the Host with one on its PATH." >&2
exit 1
